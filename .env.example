# ---- Nextcloud (WebDAV) -------------------------------------------------
# Base URL of your Nextcloud instance (no trailing /remote.php path).
NEXTCLOUD_URL=https://cloud.example.com
# The Nextcloud *user id* used in /remote.php/dav/files/<user>/ .
# In Super Productivity this is the "Username" of the Nextcloud sync settings.
NEXTCLOUD_USER=alice
# Optional: login name if you sign in with an e-mail address but the DAV
# user id differs. Leave empty if identical to NEXTCLOUD_USER.
NEXTCLOUD_LOGIN=
# Use a Nextcloud *app password* (Settings > Security > Devices & sessions).
NEXTCLOUD_PASSWORD=change-me
# Sync folder configured in Super Productivity (relative to the user root).
NEXTCLOUD_SYNC_FOLDER=/super-productivity

# ---- Super Productivity sync file ---------------------------------------
# Only needed when "Encrypt sync data" is enabled in Super Productivity.
SP_ENCRYPTION_PASSWORD=
# With a password set, a plaintext remote file is refused unless this is true.
SP_ALLOW_PLAINTEXT=false
# IANA time zone used to compute "today" (must match your devices).
SP_TIMEZONE=Europe/Berlin
# Stable identity of this server in the vector clock. Generated and stored
# in DATA_DIR on first start if empty. Do not change once set.
SP_CLIENT_ID=

# ---- MCP server ----------------------------------------------------------
# One or more bearer tokens (comma separated). Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKENS=change-me-to-a-long-random-secret
# Allow the token to be passed as a URL path segment (/t/<token>/mcp).
# Needed for clients without custom-header support (ChatGPT connectors).
MCP_ALLOW_TOKEN_IN_PATH=false
# Set to true only if the reverse proxy authenticates every request itself.
MCP_AUTH_DISABLED=false
# Public host names accepted in the Host header (comma separated). Empty
# disables DNS-rebinding protection (fine behind a reverse proxy + tokens).
MCP_ALLOWED_HOSTS=
# URL path of the MCP endpoint.
MCP_PATH=/mcp

# ---- Tuning (defaults are fine) -----------------------------------------
# Seconds a downloaded sync file is served from memory before an etag check.
SP_CACHE_TTL_SECONDS=10
# Re-download after each upload and compare hashes instead of trusting the
# etag Nextcloud returns on PUT (diagnostic; doubles the download volume).
SP_VERIFY_UPLOAD=false
# Write the previous content to sync-data.json.<UTC timestamp>.bak before
# each upload, and delete backups older than SP_BACKUP_RETENTION_DAYS.
SP_WRITE_BACKUP=true
SP_BACKUP_RETENTION_DAYS=7
# Retries when another device wrote between our download and upload.
SP_MAX_WRITE_ATTEMPTS=3
# Timeout for a single WebDAV request.
HTTP_TIMEOUT_SECONDS=120
# Retries (with backoff) for transient WebDAV failures such as a 503 during
# Nextcloud maintenance or a 423 while another client holds the file lock.
# Uploads are only retried when the server is known not to have written anything.
HTTP_MAX_RETRIES=2
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# Listen address inside the container (docker-compose maps the port).
HOST=0.0.0.0
PORT=8000
# Where client.json (this server's sync client id) is stored.
DATA_DIR=/data
